# RV1106 / Luckfox PicoKVM — UART + GMAC NFS bring-up fragment.
# Applied on top of multi_v7_defconfig.
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_ROCKCHIP=y
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_ROCKCHIP=y
CONFIG_CLK_RV1106=y
CONFIG_RESET_CONTROLLER=y
CONFIG_OF=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_ARM_GIC=y
CONFIG_ARM_ARCH_TIMER=y

# Ethernet (integrated FEPHY / RMII) for NFS root
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_STMICRO=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_DWMAC_GENERIC=y
CONFIG_PHYLIB=y
CONFIG_FIXED_PHY=y
# multi_v7_defconfig enables PCI + Intel NICs (igb/e1000e). RV1106 has no PCI.
# CONFIG_PCI is not set
# CONFIG_NET_VENDOR_INTEL is not set

# NFS root
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_ROOT_NFS=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_PNP_BOOTP=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y

# GPIO (pinctrl driver matches rockchip,rv1106-pinctrl; per-bank IOC via rockchip,grf)
CONFIG_GPIOLIB=y
CONFIG_GPIO_ROCKCHIP=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_ROCKCHIP=y

# SoC TRNG (feeds CRNG so systemd-resolved does not block ~2.5 min)
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_ROCKCHIP=y

# Rockchip peripherals present in rv1106.dtsi. Built-in: TFTP zImage
# does not ship /lib/modules unless the NFS image matches this kernel.
CONFIG_I2C=y
CONFIG_I2C_RK3X=y
CONFIG_SPI=y
CONFIG_SPI_ROCKCHIP=y
CONFIG_SPI_ROCKCHIP_SFC=y
CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_IIO=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_WATCHDOG=y
CONFIG_DW_WATCHDOG=y
CONFIG_DMADEVICES=y
CONFIG_PL330_DMA=y
CONFIG_EXTCON=y

# MMC / USB
CONFIG_MMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
# KVM target port is device-only. Dual-role + floating ID came up as xhci
# host and left /sys/class/udc empty.
CONFIG_USB_DWC3_GADGET=y
# CONFIG_USB_DWC3_HOST is not set
# CONFIG_USB_DWC3_DUAL_ROLE is not set
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_F_UAC1=y
CONFIG_CONFIGFS_FS=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y

# Early console for silent-boot debugging on UART2
CONFIG_DEBUG_KERNEL=y
CONFIG_EXPERT=y
CONFIG_DEBUG_LL=y
CONFIG_DEBUG_LL_UART_8250=y
CONFIG_DEBUG_UART_PHYS=0xff4c0000
CONFIG_DEBUG_UART_VIRT=0xff4c0000
CONFIG_DEBUG_UART_8250_SHIFT=2
CONFIG_DEBUG_UART_8250_WORD=y
CONFIG_EARLY_PRINTK=y
CONFIG_SERIAL_EARLYCON=y
# Prefer bootloader FDT from bootz over an appended blob
# CONFIG_ARM_APPENDED_DTB is not set

# HDMI capture: TC358743 → CSI2 DPHY → MIPI CSI-2 → RKCIF
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
# CONFIG_MEDIA_SUBDRV_AUTOSELECT is not set
CONFIG_VIDEO_DEV=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_MEDIA_PLATFORM_DRIVERS=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_ROCKCHIP_RGA=y
CONFIG_VIDEOBUF2_CORE=y
CONFIG_VIDEOBUF2_V4L2=y
CONFIG_VIDEOBUF2_MEMOPS=y
CONFIG_VIDEOBUF2_DMA_CONTIG=y
CONFIG_VIDEOBUF2_DMA_SG=y
CONFIG_VIDEOBUF2_VMALLOC=y
CONFIG_V4L2_FWNODE=y
CONFIG_V4L2_ASYNC=y
CONFIG_VIDEO_V4L2_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_VIDEO_TC358743=y
CONFIG_VIDEO_ROCKCHIP_CIF=y
CONFIG_PHY_ROCKCHIP_CSI2_DPHY=y
CONFIG_GENERIC_PHY=y
CONFIG_MFD_SYSCON=y
CONFIG_REGMAP=y
CONFIG_REGMAP_MMIO=y
CONFIG_PM=y
CONFIG_PM_OPP=y
# multi_v7 already has CPUFREQ_DT. Governors built-in (TFTP zImage has no
# matching modules). Stay on U-Boot 816 until userspace sets an OPP —
# assigned-clocks/performance at 1.2 GHz hung PicoKVM during bring-up.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPUFREQ_DT=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=32
CONFIG_ROCKCHIP_KMPP=y
CONFIG_OF_RESERVED_MEM=y

# RV1106 Crypto Engine v3 — AES-GCM SRTP TX (/dev/onekvm-crypto-offload)
CONFIG_CRYPTO_HW=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_GHASH=y
CONFIG_CRYPTO_DEV_ROCKCHIP_V3=y
