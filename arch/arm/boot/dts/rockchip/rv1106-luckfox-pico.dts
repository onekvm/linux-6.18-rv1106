/*
 * Copyright (c) 2026 OneKVM
 *
 * Luckfox PicoKVM (RV1106G3) — lab NFS bring-up board (picokvm-139).
 * Console baud matches stock U-Boot (115200), not the common Luckfox 1.5M.
 */

/dts-v1/;

#include "rv1106.dtsi"

/ {
	model = "Luckfox PicoKVM (OneKVM bring-up)";
	compatible = "luckfox,pico-kvm", "luckfox,pico", "rockchip,rv1106";

	aliases {
		/* Only UART2 is enabled; 8250 enumerates it as ttyS0. */
		serial0 = &uart2;
		serial2 = &uart2;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		/* Match stock U-Boot banks (OP-TEE hole at 0x03000000). */
		reg = <0x00000000 0x03000000>,
		      <0x03288000 0x0cd78000>;
	};
};

&uart2 {
	status = "okay";
};

&gmac {
	status = "okay";
};
